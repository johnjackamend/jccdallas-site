 "month": "2026-11",
 "title": "November 2026 Seniors Calendar",
 "pdf": "/assets/seniors/calendar-2026-11.pdf",
 "note": "Events on this calendar are open to Total J and Senior Social members. Health insurance memberships (Silver Sneakers, etc.) do not include senior programming. Membership of any kind is not required for the lunch program. Programs marked with a fee incur an additional charge. Save the dates: Games Day, Sunday, November 15, and the Art Exhibition and Brunch, Thursday, December 3.",
 "contacts": [
  {
   "name": "Sharon Cane",
   "phone": "214-239-7183",
   "email": "scane@jccdallas.org"
  },
